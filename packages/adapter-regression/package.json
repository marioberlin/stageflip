{
  "name": "@stageflip/adapter-regression",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "src", "snapshots"],
  "scripts": {
    "build": "tsup src/index.ts --dts --format esm,cjs --clean",
    "dev": "tsup src/index.ts --dts --format esm,cjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@stageflip/3d-meshy": "workspace:*",
    "@stageflip/3d-tripo": "workspace:*",
    "@stageflip/adapters-core": "workspace:*",
    "@stageflip/asset-cache": "workspace:*",
    "@stageflip/asset-gen-contract": "workspace:*",
    "@stageflip/music-acestep": "workspace:*",
    "@stageflip/music-yue": "workspace:*",
    "@stageflip/sfx-stable-audio": "workspace:*",
    "@stageflip/tts-fish-speech": "workspace:*",
    "@stageflip/tts-kokoro": "workspace:*",
    "@stageflip/video-runway": "workspace:*",
    "@stageflip/video-seedance": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "2.1.9",
    "vitest": "2.1.9"
  }
}
