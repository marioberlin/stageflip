{
  "name": "@stageflip/runtimes-audience",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./export-frame": {
      "types": "./dist/export-frame.d.ts",
      "import": "./dist/export-frame.js",
      "require": "./dist/export-frame.cjs"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsup src/index.ts src/export-frame.ts --dts --format esm,cjs --clean",
    "dev": "tsup src/index.ts src/export-frame.ts --dts --format esm,cjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@stageflip/audience-contract": "workspace:*",
    "@stageflip/loss-flags": "workspace:*",
    "@stageflip/runtimes-contract": "workspace:*",
    "@stageflip/runtimes-interactive": "workspace:*",
    "@stageflip/runtimes-shader": "workspace:*",
    "@stageflip/schema": "workspace:*",
    "zod": "3.25.76"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "2.1.9",
    "happy-dom": "20.9.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "vitest": "2.1.9"
  },
  "license": "BUSL-1.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/marioberlin/stageflip.git",
    "directory": "packages/runtimes/audience"
  }
}
